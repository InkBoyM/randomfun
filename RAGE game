<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Endless Platformer with Spikes and Stopwatch</title>
    <style>
        body {
            margin: 0;
            overflow: hidden;
        }

        canvas {
            display: block;
            background-color: #87CEEB;
            /* Light Blue */
        }

        #stopwatch {
            position: absolute;
            top: 10px;
            left: 10px;
            font-size: 18px;
            color: white;
        }

        #settingsContainer {
            position: absolute;
            top: 10px;
            right: 10px;
            display: flex;
            flex-direction: column;
        }

        #doubleJumpSwitchLabel,
        #speedLabel,
        #jumpHeightLabel {
            font-size: 14px;
            margin-bottom: 5px;
            color: black;
        }

        #doubleJumpSwitch,
        #speedInput,
        #jumpHeightInput,
        #setSpeedBtn,
        #setJumpHeightBtn {
            margin-bottom: 10px;
        }

        #settingsBtn {
            font-size: 18px;
            color: white;
            cursor: pointer;
        }
    </style>
</head>

<body>

    <canvas id="gameCanvas" width="800" height="600"></canvas>
    <div id="stopwatch">Time: 0s</div>
    <div id="settingsContainer">
        <label id="doubleJumpSwitchLabel" for="doubleJumpSwitch">infinte Jump:</label>
        <input type="checkbox" id="doubleJumpSwitch" onclick="toggleDoubleJump()" checked>

        <label id="speedLabel" for="speedInput">Speed:</label>
        <input type="number" id="speedInput" value="5" min="1" max="10">
        <button id="setSpeedBtn" onclick="setSpeed()">Set Speed</button>

        <label id="jumpHeightLabel" for="jumpHeightInput">Jump Height:</label>
        <input type="number" id="jumpHeightInput" value="15" min="1" max="30">
        <button id="setJumpHeightBtn" onclick="setJumpHeight()">Set Jump Height</button>
    </div>

    <script>
        const canvas = document.getElementById("gameCanvas");
        const ctx = canvas.getContext("2d");

        const player = {
            x: 50,
            y: canvas.height - 30,
            width: 30,
            height: 30,
            color: "red",
            velocityX: 0,
            velocityY: 0,
            jumping: false,
            canJump: true,
            canDoubleJump: true // Default: Double Jump is enabled
        };

        const platforms = [{
                x: 50,
                y: canvas.height - 20,
                width: 100,
                height: 20
            },
            {
                x: 200,
                y: canvas.height - 40,
                width: 80,
                height: 20
            },
            {
                x: 400,
                y: canvas.height - 60,
                width: 60,
                height: 20
            },
            {
                x: 600,
                y: canvas.height - 80,
                width: 40,
                height: 20
            },
            {
                x: 300,
                y: canvas.height - 100,
                width: 30,
                height: 20,
                type: "spike"
            },
            // Add more platforms or spikes as needed
        ];

        let elapsedTime = 0;
        const stopwatchElement = document.getElementById("stopwatch");
        const doubleJumpSwitch = document.getElementById("doubleJumpSwitch");
        const speedInput = document.getElementById("speedInput");
        const jumpHeightInput = document.getElementById("jumpHeightInput");

        doubleJumpSwitch.addEventListener("change", toggleDoubleJump);

        function handleKeyPress(event) {
            if (event.key === "ArrowLeft") {
                player.velocityX = -parseFloat(speedInput.value);
            } else if (event.key === "ArrowRight") {
                player.velocityX = parseFloat(speedInput.value);
            } else if (event.key === "ArrowUp" && (player.canJump || player.canDoubleJump)) {
                // Check if the player can jump
                if (!player.jumping) {
                    player.canJump = false; // Set to false when starting a new jump
                }

                // Adjust the jump velocity based on the jump height input
                const jumpHeight = parseFloat(jumpHeightInput.value);
                player.velocityY = -jumpHeight;

                player.jumping = true;
            }
        }

        function handleKeyRelease(event) {
            if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
                player.velocityX = 0;
            }
        }

        function toggleDoubleJump() {
            player.canDoubleJump = doubleJumpSwitch.checked;
        }

        function setSpeed() {
            const newSpeed = parseFloat(speedInput.value);
            if (!isNaN(newSpeed) && newSpeed > 0) {
                // Update the player's velocityX with the new speed
                player.velocityX = (player.velocityX / Math.abs(player.velocityX)) * newSpeed;
            }
        }

        function setJumpHeight() {
            // Jump height is updated dynamically during keypress
            // Adjusting jump height directly during the jump might result in unexpected behavior
        }

        function update() {
            // Update player position
            player.x += player.velocityX;
            player.y += player.velocityY;

            // Apply stronger gravity
            player.velocityY += 0.8;

            // Check for collisions with platforms and spikes
            for (const platform of platforms) {
                if (
                    player.x < platform.x + platform.width &&
                    player.x + player.width > platform.x &&
                    player.y < platform.y + platform.height &&
                    player.y + player.height > platform.y
                ) {
                    if (platform.type === "spike") {
                        // Collision with spike, reset the game
                        resetGame();
                    } else {
                        // Collision with platform, stop jumping and set player on top of the platform
                        player.jumping = false;
                        player.velocityY = 0;
                        player.y = platform.y - player.height;
                        player.canJump = true; // Allow jumping again when landing on a platform
                    }
                }
            }

            // Check if player falls off the screen
            if (player.y > canvas.height) {
                resetGame();
            }

            // Move platforms upward
            for (const platform of platforms) {
                platform.y -= 2;
                if (platform.y + platform.height < 0) {
                    // If a platform is above the canvas, move it to the bottom with a new random width
                    platform.y = canvas.height;
                    platform.width = Math.random() * (100 - 40) + 40;
                    // Ensure spikes are randomly placed
                    if (Math.random() < 0.2) {
                        platform.type = "spike";
                    } else {
                        platform.type = undefined;
                    }
                }
            }

            // Update and display the stopwatch
            elapsedTime++;
            stopwatchElement.textContent = `Time: ${elapsedTime}s`;

            // Clear the canvas
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Draw player
            ctx.fillStyle = player.color;
            ctx.fillRect(player.x, player.y, player.width, player.height);

            // Draw platforms and spikes
            for (const platform of platforms) {
                ctx.fillStyle = platform.type === "spike" ? "red" : "gray";
                ctx.fillRect(platform.x, platform.y, platform.width, platform.height);
            }

            requestAnimationFrame(update);
        }

        function resetGame() {
            player.x = 50;
            player.y = canvas.height - 30;
            player.velocityX = 0;
            player.velocityY = 0;
            player.jumping = false;
            player.canJump = true;

            // Reset platforms to the initial position
            platforms.forEach((platform, index) => {
                platform.y = canvas.height - (20 * (index + 1));
                platform.type = undefined;
            });

            // Reset the stopwatch
            elapsedTime = 0;
            stopwatchElement.textContent = `Time: ${elapsedTime}s`;
        }

        // Event listeners for key press and release
        document.addEventListener("keydown", handleKeyPress);
        document.addEventListener("keyup", handleKeyRelease);

        // Start the game loop
        update();
    </script>

</body>

</html>
